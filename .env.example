# =============================================================================
# AI-Powered NL-to-SQL Analytics Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_NAME=ai-text-to-sql
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Authentication ---
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_256_BIT_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Primary Database (Application + Analytics) ---Ak
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/analytics_platform 
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Analytics Database (target for user queries) ---
ANALYTICS_DATABASE_URL=postgresql+asyncpg://readonly_user:readonly_pass@localhost:5432/analytics_db

# --- LLM Provider ---
LLM_PROVIDER=openai
LLM_API_KEY=<YOUR_LLM_API_KEY>
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30

# --- Embedding Provider ---
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=<YOUR_EMBEDDING_API_KEY>
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Vector Database --- Ak
VECTOR_STORE_PROVIDER=chromadb
VECTOR_STORE_URL=http://localhost:8001
VECTOR_STORE_COLLECTION=schema_embeddings

# --- Query Safety ---
MAX_QUERY_COST=1000000
MAX_EXECUTION_TIME_SECONDS=30
MAX_ROWS_RETURNED=1000
MAX_RETRIES=3

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_QUERIES_PER_HOUR=100

# --- Observability ---
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
ENABLE_TRACING=false
ENABLE_METRICS=true

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Redis (optional, for rate limiting / caching) ---
REDIS_URL=redis://localhost:6379/0
